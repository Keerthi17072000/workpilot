# ---- Supabase (required) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only. NEVER put in apps/web
VITE_SUPABASE_URL=                  # same URL, exposed to the browser
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8787

# ---- API ----
API_PORT=8787
APP_URL=http://localhost:5173       # CORS origin + post-OAuth redirect
API_PUBLIC_URL=http://localhost:8787 # used to build OAuth redirect URIs: {API_PUBLIC_URL}/v1/oauth/callback
TOKEN_ENCRYPTION_KEY=               # 32 bytes, base64: openssl rand -base64 32
OAUTH_STATE_KEY=                    # 32 bytes, base64: openssl rand -base64 32

# ---- Provider OAuth apps (a provider without these shows "Not configured" in the UI) ----
GOOGLE_CLIENT_ID=                   # Gmail + Calendar. Restricted Gmail scopes need Google verification for non-test users
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=               # webhook verification
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
